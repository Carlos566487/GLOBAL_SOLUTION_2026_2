# Copie para .env e preencha. Nunca commite o .env.
GEMINI_API_KEY=
# Vazio = padrão de src/ia/config.py (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
# Usados em ordem se o principal esgotar as retentativas (429/500/503) ou der 504/timeout. Separados por vírgula.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.8-flash
# Avaliação: modelo fixo, sem fallback. Vazio = GEMINI_MODEL.
EVAL_MODEL=gemini-3.5-flash-lite
